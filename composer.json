{
    "name": "zinxan/native-mobile",
    "description": "NativeWatch error tracking for NativePHP iOS and Android apps, with consent controls and native crash reporting.",
    "keywords": [
        "nativephp",
        "laravel",
        "ios",
        "android",
        "error-tracking",
        "crash-reporting",
        "nativewatch"
    ],
    "type": "nativephp-plugin",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "zinxan/native-core": "^0.2"
    },
    "suggest": {
        "nativephp/mobile": "NativePHP Mobile 4; native UI integration is verified with 4.5."
    },
    "autoload": {
        "psr-4": {
            "ZXN\\NativeWatch\\Mobile\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "ZXN\\NativeWatch\\Mobile\\MobileServiceProvider"
            ],
            "aliases": {
                "NativeWatch": "ZXN\\NativeWatch\\Core\\Laravel\\NativeWatch"
            }
        },
        "nativephp": {
            "manifest": "nativephp.json"
        }
    },
    "minimum-stability": "stable",
    "homepage": "https://native.watch",
    "support": {
        "docs": "https://native.watch/docs/install-mobile",
        "issues": "https://github.com/zinxan/native.mobile/issues",
        "source": "https://github.com/zinxan/native.mobile"
    }
}
