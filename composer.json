{
    "name": "zinxan/native-mobile",
    "description": "NativeWatch error tracking for NativePHP iOS and Android apps, with consent controls and native crash reporting.",
    "keywords": [
        "nativephp",
        "laravel",
        "ios",
        "android",
        "error-tracking",
        "crash-reporting",
        "nativewatch"
    ],
    "type": "nativephp-plugin",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "zinxan/native-core": "^0.2"
    },
    "suggest": {
        "nativephp/mobile": "NativePHP Mobile 4; native UI integration is verified with 4.5."
    },
    "autoload": {
        "psr-4": {
            "ZXN\\NativeWatch\\Mobile\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "ZXN\\NativeWatch\\Mobile\\MobileServiceProvider"
            ],
            "aliases": {
                "NativeWatch": "ZXN\\NativeWatch\\Core\\Laravel\\NativeWatch"
            }
        },
        "nativephp": {
            "manifest": "nativephp.json"
        }
    },
    "minimum-stability": "stable",
    "homepage": "https://native.watch",
    "support": {
        "docs": "https://native.watch/docs/install-mobile",
        "issues": "https://github.com/zinxan/native.mobile/issues",
        "source": "https://github.com/zinxan/native.mobile"
    },
    "require-dev": {
        "larastan/larastan": "^3.9",
        "laravel/pint": "^1.27",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.8|^4.0|^5.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0|^5.0",
        "pestphp/pest-plugin-type-coverage": "^3.0|^4.0|^5.0"
    },
    "autoload-dev": {
        "psr-4": {
            "ZXN\\NativeWatch\\Mobile\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "scripts": {
        "test": [
            "@test:lint",
            "@test:types",
            "@test:type-coverage",
            "@test:unit"
        ],
        "test:lint": "pint --test",
        "test:types": "phpstan analyse --memory-limit=1G",
        "test:unit": "pest --compact",
        "test:type-coverage": "pest --type-coverage --min=100"
    }
}
