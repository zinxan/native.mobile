{
    "name": "zinxan/native-mobile",
    "description": "Error tracking for NativePHP iOS and Android apps, reported to NativeWatch.",
    "keywords": [
        "nativephp",
        "laravel",
        "ios",
        "android",
        "error-tracking",
        "nativewatch"
    ],
    "type": "nativephp-plugin",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "zinxan/native-core": "^0.1"
    },
    "suggest": {
        "nativephp/mobile": "The NativePHP mobile runtime that this SDK reports for."
    },
    "autoload": {
        "psr-4": {
            "ZXN\\NativeWatch\\Mobile\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "ZXN\\NativeWatch\\Mobile\\MobileServiceProvider"
            ],
            "aliases": {
                "NativeWatch": "ZXN\\NativeWatch\\Core\\Laravel\\NativeWatch"
            }
        },
        "nativephp": {
            "manifest": "nativephp.json"
        }
    },
    "minimum-stability": "stable"
}
