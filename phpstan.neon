includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 7
    paths:
        - src
        - tests/Fixtures/NativeUiTypeCheck.php
    tmpDir: .phpstan-cache
    dynamicConstantNames:
        - FILTER_FLAG_GLOBAL_RANGE
    scanFiles:
        - stubs/nativephp.php
        - stubs/native-ui.stub
